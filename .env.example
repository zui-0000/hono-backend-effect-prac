# compose.yaml の Postgres に合わせた開発用接続情報。
# 実ファイルは .env にコピーして使う (.env は .gitignore 済み)。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hono_effect_prac

# アクセストークン (JWT / HS256) の署名鍵。32 文字以上。
# 開発用の値なので秘密ではないが、本番は Secrets Manager 等から注入する。
# 短い鍵は総当たりで割られ、しかも割られても正常に動いて見えるため、
# 起動時に長さごと検証して落とす (shared/infrastructure/access-token-issuer-live.ts)。
# 生成例: openssl rand -hex 32
JWT_SECRET=dev-only-secret-do-not-use-in-production-0123456789abcdef

# リフレッシュトークンの Cookie 属性のうち、環境で変わる 2 つ。
# 既定は「Secure を付ける / Domain は付けない」= いちばん狭い側。
# 設定を忘れた環境が安全側に倒れるよう、外すときだけ明示的に書く。
#
# ローカルは http:// で叩くため Secure を外す (付いていると送られない)。
COOKIE_SECURE=false
# サブドメイン間で共有するときだけ設定する (例: example.com)。
# 未設定なら発行したホストにだけ送られる。
# COOKIE_DOMAIN=
