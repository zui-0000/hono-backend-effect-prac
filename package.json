{
  "name": "hono-backend-effect-prac",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test --path-ignore-patterns \"**/presentation/**\"",
    "test:api": "bun test presentation",
    "check:types": "tsc --noEmit",
    "check:lint": "oxlint -c .oxlintrc.jsonc",
    "check:deps": "depcruise src --config .dependency-cruiser.mjs --output-type err-long",
    "check:effect": "effect-tsgo diagnostics --project tsconfig.json --format pretty --strict",
    "check:updates": "pnpm outdated --long",
    "check:updates:pending": "pnpm --config.minimumReleaseAge=0 outdated --long",
    "format:check": "oxfmt -c .oxfmtrc.jsonc --check",
    "format:fix": "oxfmt -c .oxfmtrc.jsonc",
    "lint:fix": "pnpm check:lint --fix && pnpm format:fix && pnpm check:types && pnpm check:deps",
    "generate:api": "orval",
    "prepare": "pnpm generate:api && effect-tsgo patch --typescript && mise exec -- hk install --mise",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "bun run db/migrate.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.0",
    "@swc/core": "^1.15.47",
    "@types/bun": "^1.3.14",
    "dependency-cruiser": "^18.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "orval": "^8.24.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2"
  }
}
