{
  "compilerOptions": {
    // --- Effect 固有の診断 (@effect/tsgo) ---
    //     プラグイン名がパッケージ名と違う (@effect/language-service) ことに注意。
    //     エディタでは補完・リファクタ・hover に、CI では check:effect に効く。
    //     tsc / oxlint が見つけられない種類 —— yield* し忘れた Effect、
    //     Layer.mergeAll 内の依存、catch できないエラーの捕捉など —— を見る。
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "refactors": true,
        "quickinfo": true,
        "completions": true,
        // unnecessaryPipeChain は「連鎖した pipe を 1 つにまとめよ」という Style ルール。
        // このリポジトリは逆に **1 段ずつ分ける** と決めているので明示的に切る。
        // `pipe(a, b, c)` はカンマ区切りが「同時に渡している」ように見えるが、
        // 実際は左から順に適用される変換の連なり。読み違えを避けるため
        // `.pipe(a).pipe(b)` に揃えた (意味は同一。docs/02-architecture.md 参照)。
        // 正しさではなく読み味の話なので、公式の推奨と分かれても構わないと判断した。
        "diagnosticSeverity": { "unnecessaryPipeChain": "off" }
      }
    ],

    // --- 出力 (Bun が直接 TS を実行するため emit しない) ---
    "noEmit": true,
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    // --- Bun のグローバル型 ---
    "types": ["bun"],

    // --- パスエイリアス (package by feature の import を短く保つ)
    //     TS 7 で baseUrl は廃止。paths は tsconfig の場所を基準に解決される。
    //     ~ を採用: @scope 付き npm パッケージ (@types/*, @hono/* 等) との混同を避けるため ---
    "paths": {
      "~/*": ["./src/*"]
    },

    // --- 厳格化 (DDD の学習用途なので型で守りを固める) ---
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "db/**/*.ts"]
}
